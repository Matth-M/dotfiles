[credential]
	helper = cache
[init]
	defaultBranch = main
    templateDir = ~/.config/git/template
[core]
	editor = nvim
	autocrlf = input
[help]
	autocorrect = prompt
[commit]
	template = /home/matth/.config/git/gitCommitMessage.txt
[status]
	showUntrackedFiles = no
[alias]
	d = "diff"
	dl = "diff HEAD~ HEAD"
	dc = "diff --cached"

	df = "-c diff.external=difft diff --ext-diff"
	dfl = "-c diff.external=difft show --ext-diff"
	dfc="-c diff.external=difft diff --cached --ext-diff"

	s = "status --branch --short"
	st = "status"
	su = "status --untracked-files --short --branch"

	rs = "restore --staged"
	cm = "commit -m"
	ap = "add -p"
	ai = "add -i"
	can = "commit --amend --no-edit"

	cb = "checkout -b"
	ch = "checkout"

	ls = "log --oneline --graph -15"
	la = "log --oneline --graph --all"
	las = "log --oneline --graph --all -15"
	l = "log --oneline --graph"
	ld="-c diff.external=difft log -p  --ext-diff"
	cmp = "log --oneline --graph HEAD"

	dmb = !git branch --merged | grep -v 'main' | xargs -I {} git branch -d {}
	b = "branch"
	wt = "worktree"
	mf = "merge --ff-only"
	alias = !git config --list | grep alias # | cut -d '.' -f2 | awk '$1=$1' OFS='\t' FS='='

[user]
	email = matthieu.matsima@gmail.com
	name = Matth-M

[merge]
	tool = nvimdiff
